# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side override passcode for Head Librarian admin login.
# If unset, use the first-run Admin Setup form in the UI to claim the admin password.
ADMIN_PASSCODE=

# SMTP Configuration (Optional - for automated weekly email report delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="library-reports@dnyanshree.edu.in"

# NTFY_TOPIC (Optional - for instant admin mobile push notifications via ntfy.sh or webhook)
NTFY_TOPIC=
